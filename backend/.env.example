# Application
APP_ENV=production
HTTP_ADDR=:8080
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_FILE=.log/access.log
# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dvapi?sslmode=disable

# Goose migrations (used by bin/migrate and goose CLI)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/dvapi?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations
GOOSE_TABLE=custom.goose_migrations

#REDIS
REDIS_URL=redis://localhost:6379

# SMTP (MailHog defaults for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dvapi.local